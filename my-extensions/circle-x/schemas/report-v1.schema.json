{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "circle-x report v1",
  "description": "Stable report ID plus either a live report or a permanent withdrawal record. No TTL.",
  "type": "object",
  "required": [
    "reportId",
    "withdrawn",
    "updatedAt"
  ],
  "properties": {
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "withdrawn": {
      "type": "boolean"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "report": {
      "type": "object",
      "required": [
        "type",
        "entityId",
        "bumperNumber",
        "vehicleType",
        "operator",
        "uic",
        "phases",
        "faults",
        "latitude",
        "longitude",
        "timestamp"
      ],
      "properties": {
        "type": {
          "const": "circle-x.report"
        },
        "entityId": {
          "type": "string",
          "minLength": 1
        },
        "bumperNumber": {
          "type": "string"
        },
        "vehicleType": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "uic": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/phase"
          },
          "uniqueItems": true
        },
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "itemId",
              "phase",
              "severity",
              "recordedAt"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "minLength": 1
              },
              "phase": {
                "$ref": "#/definitions/phase"
              },
              "category": {
                "type": "string"
              },
              "subcategory": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "severity": {
                "$ref": "#/definitions/severity"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recordedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "signature": {
          "$ref": "#/definitions/signature"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "maintainerReview": {
          "type": "object",
          "required": [
            "sourceReportId",
            "faults",
            "signature"
          ],
          "properties": {
            "sourceReportId": {
              "type": "string",
              "minLength": 1
            },
            "faults": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "itemId",
                  "phase",
                  "verified",
                  "description"
                ],
                "properties": {
                  "itemId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "$ref": "#/definitions/phase"
                  },
                  "verified": {
                    "type": "boolean"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "additionalProperties": false
              },
              "uniqueItems": true
            },
            "signature": {
              "allOf": [
                {
                  "$ref": "#/definitions/signature"
                },
                {
                  "properties": {
                    "verified": {
                      "const": true
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "withdrawn": {
          "const": false
        }
      },
      "required": [
        "report"
      ]
    },
    {
      "properties": {
        "withdrawn": {
          "const": true
        }
      },
      "not": {
        "required": [
          "report"
        ]
      }
    }
  ],
  "definitions": {
    "phase": {
      "type": "string",
      "enum": [
        "BEFORE",
        "DURING",
        "AFTER"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "RED_X",
        "CIRCLE_X",
        "DASH"
      ]
    },
    "cacIdentity": {
      "type": "object",
      "required": [
        "edipi",
        "firstName",
        "lastName",
        "verifiedAt"
      ],
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "middleInitial": {
          "type": "string"
        },
        "rank": {
          "type": "string"
        },
        "branchCode": {
          "type": "string"
        },
        "categoryCode": {
          "type": "string"
        },
        "cardInstance": {
          "type": "string"
        },
        "edipi": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[1-9][0-9]{9}$"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "cardExpiresOn": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "attestedIdentity": {
      "type": "object",
      "required": [
        "edipi",
        "firstName",
        "lastName"
      ],
      "properties": {
        "edipi": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[1-9][0-9]{9}$"
        },
        "firstName": {
          "type": "string",
          "pattern": "\\S"
        },
        "lastName": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "verified",
        "signedAt"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "signedAt": {
          "type": "string",
          "format": "date-time"
        },
        "identity": {
          "$ref": "#/definitions/cacIdentity"
        },
        "attestedBy": {
          "$ref": "#/definitions/attestedIdentity"
        },
        "blockedBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "verified": {
              "const": true
            }
          },
          "required": [
            "identity"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "blockedBy"
                ]
              },
              {
                "required": [
                  "attestedBy"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "verified": {
              "const": false
            }
          },
          "required": [
            "blockedBy"
          ],
          "not": {
            "required": [
              "identity"
            ]
          }
        }
      ]
    }
  }
}
